--  1.1 Keyspace
CREATE KEYSPACE smartgrid
WITH replication = {
  'class': 'NetworkTopologyStrategy',
  'datacenter1': 3
}
AND durable_writes = true;

USE smartgrid;

--  1.2 mesures_par_capteur
CREATE TABLE mesures_par_capteur (
  capteur_id UUID,
  date DATE,
  timestamp TIMESTAMP,
  tension FLOAT,
  courant FLOAT,
  puissance FLOAT,
  alerte BOOLEAN,
  PRIMARY KEY ((capteur_id, date), timestamp)
) WITH CLUSTERING ORDER BY (timestamp DESC)
AND default_time_to_live = 7776000; -- 90 jours

--  1.3 alertes_par_wilaya
CREATE TABLE alertes_par_wilaya (
  wilaya TEXT,
  date DATE,
  timestamp TIMESTAMP,
  capteur_id UUID,
  tension FLOAT,
  PRIMARY KEY ((wilaya, date), timestamp, capteur_id)
) WITH CLUSTERING ORDER BY (timestamp DESC)
AND default_time_to_live = 31536000; -- 1 an

--  1.4 agregats_horaires
CREATE TABLE agregats_horaires (
  wilaya TEXT,
  date DATE,
  heure INT,
  consommation_moy FLOAT,
  PRIMARY KEY ((wilaya, date), heure)
)
AND default_time_to_live = 157680000; -- 5 ans
