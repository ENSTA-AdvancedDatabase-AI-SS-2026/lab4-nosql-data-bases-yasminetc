-- 🔹 3.1 Mesures dernières 6h
SELECT * FROM mesures_par_capteur
WHERE capteur_id = ? AND date = ?
AND timestamp >= toTimestamp(now()) - 21600000;

-- 🔹 3.2 Dernière mesure
SELECT * FROM mesures_par_capteur
WHERE capteur_id = ? AND date = ?
LIMIT 1;

-- 🔹 3.3 Alertes Alger
SELECT * FROM alertes_par_wilaya
WHERE wilaya = 'Alger' AND date = currentDate;

-- 🔹 3.4 Consommation par heure
SELECT heure, consommation_moy
FROM agregats_horaires
WHERE wilaya = 'Alger' AND date = currentDate;

-- 🔹 3.5 Anomalies tension
SELECT * FROM mesures_par_capteur
WHERE capteur_id = ? AND date = ?
AND (tension < 200 OR tension > 240);

-- 🔹 3.6 Top capteurs actifs (table dédiée recommandée)
-- sinon impossible efficacement sans redesign

-- 🔹 3.7 ALLOW FILTERING (à éviter)
SELECT * FROM mesures_par_capteur
WHERE tension > 240 ALLOW FILTERING;
